# Copy to .env (gitignored) and fill in. Never commit real values.
# All variables below are required. See docs/methodology.md, "Test prerequisites".

# Base URL of the performance environment's entry point, e.g. https://<perf-host>
CHAT_HOST=https://your-performance-environment.example

# ID of the service registered for the stubbed model. Sent as "model" in every request.
# Must be a service ID, not a model name: /api/v1/chat returns 404 for a name.
SERVICE_ID=your-stub-service-id

# Three long-lived API keys, used round-robin. All three need access to the service above.
# The names (Admin, Tenant Admin 1, Tenant Admin 2) only label the results.
API_KEY_ADMIN=replace-me
API_KEY_TENANT_ADMIN_1=replace-me
API_KEY_TENANT_ADMIN_2=replace-me

# Not set here: WORKER_INDEX, MASTER_HOST and MASTER_PORT are plain shell variables for
# distributed runs (see docs/environment.md). They are not read from this file.
